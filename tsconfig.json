{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client", "vitest/globals", "@testing-library/jest-dom/vitest"]
  },
  // The Edge Function's entry point is Deno, not TypeScript for the browser,
  // so only its pure guard (which imports nothing) is checked here.
  "include": ["src", "vite.config.ts", "supabase/functions/delete-account/guard.ts", "supabase/functions/delete-account/guard.test.ts"]
}
