# Browser configuration. Only public values belong here: anything prefixed
# VITE_ is compiled into the bundle and visible to every visitor.
# Never put the service-role key or a database password in this file.

# Local: printed by `supabase start` (API URL and publishable/anon key).
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-the-local-publishable-key
