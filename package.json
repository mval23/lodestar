{
  "name": "lodestar",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "schema:check": "node supabase/tests/check-schema.mjs",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:gate": "psql postgresql://postgres:postgres@127.0.0.1:54322/postgres -v ON_ERROR_STOP=1 -f supabase/checks/rls_gate.sql",
    "db:types": "supabase gen types typescript --local --schema public > src/lib/database.types.ts",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "build:e2e": "vite build --mode e2e",
    "backup": "node scripts/backup/cli.mjs",
    "restore": "node scripts/backup/cli.mjs restore",
    "readme:shots": "playwright test --config scripts/readme/playwright.config.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@electric-sql/pglite": "^0.3.0",
    "@eslint/js": "^10.0.1",
    "@notionhq/client": "^5.26.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^30.1.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@hookform/resolvers": "^5.9.1",
    "@supabase/supabase-js": "^2.116.0",
    "@tanstack/react-query": "^5.103.1",
    "@types/papaparse": "^5.5.2",
    "@visx/axis": "^4.0.0",
    "@visx/group": "^4.0.0",
    "@visx/scale": "^4.0.0",
    "@visx/shape": "^4.0.0",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.47.0",
    "papaparse": "^5.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.88.0",
    "react-router": "^8.4.0",
    "zod": "^4.6.5"
  },
  "engines": {
    "node": ">=22"
  }
}
